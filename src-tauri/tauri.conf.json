{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Packetcode",
  "version": "0.1.0",
  "identifier": "net.ianlan.packetcode-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Packetcode",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Ian Walmsley",
    "category": "DeveloperTool",
    "shortDescription": "Desktop client for the packetcode coding agent",
    "longDescription": "Packetcode is a desktop client for the packetcode coding agent. The packetcode engine is installed separately and auto-updates independently; it is never bundled with this application.",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Ian Walmsley",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "7238fcdc-52ea-4989-ae3e-b4c2623d74b0"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
